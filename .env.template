# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456789
DB_NAME=cctv_surveillance

# JWT Auth
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Streamlit
STREAMLIT_PORT=8501

# Storage
DATA_DIR=./data
UNKNOWN_FACES_DIR=./data/unknown_faces
KNOWN_FACES_DIR=./data/known_faces
LOGS_DIR=./data/logs

# Detection
YOLO_MODEL=yolov8m-face.pt
YOLO_CONFIDENCE=0.5
FACE_MATCH_THRESHOLD=0.75
MIN_FACE_SIZE=64

# Processing
DEFAULT_PROCESSING_FPS=15
MAX_CAMERAS=50
FRAME_BUFFER_SIZE=100

# DeepSORT
DEEPSORT_MAX_AGE=30
DEEPSORT_MIN_HITS=3
DEEPSORT_MAX_IOU_DISTANCE=0.7
DEEPSORT_MAX_COSINE_DISTANCE=0.4
